{
  "manifest_version": 3,
  "name": "Less Pull Extension",
  "version": "0.4.3",
  "description": "Connects your browser to the Less Pull Mac app, so websites can have their own display settings. Set them from the Less Pull menu.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lesspull@jiriarion.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
